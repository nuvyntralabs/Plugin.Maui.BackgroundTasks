<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BackgroundTasks.Sample.MainPage"
             Title="Background Tasks">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="MAUI Background Tasks"
                   FontSize="28"
                   FontAttributes="Bold" />
            <Label x:Name="PlatformLabel"
                   Text="Platform: unknown"
                   TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" />
            <Label x:Name="StatusLabel" Text="Ready" />
            <Label x:Name="LastRunLabel" Text="Last run: none" />

            <Label Text="One-time" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Schedule refresh" Clicked="OnScheduleOneTimeClicked" />
                <Button Grid.Column="1" Text="Schedule processing" Clicked="OnScheduleProcessingClicked" />
            </Grid>

            <Label Text="Periodic" FontAttributes="Bold" />
            <Button Text="Schedule periodic refresh (15 min)" Clicked="OnSchedulePeriodicClicked" />

            <Label Text="Control" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                <Button Text="Run refresh now" Clicked="OnRunRefreshNowClicked" />
                <Button Grid.Column="1" Text="Run processing now" Clicked="OnRunProcessingNowClicked" />
                <Button Grid.Row="1" Text="Refresh list" Clicked="OnRefreshListClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Cancel all" Clicked="OnCancelAllClicked" />
            </Grid>

            <HorizontalStackLayout Spacing="12">
                <Switch x:Name="LoggingSwitch" IsToggled="True" Toggled="OnLoggingToggled" />
                <Label Text="Enable logging" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Scheduled" FontAttributes="Bold" />
            <Label x:Name="ScheduledLabel" Text="None." LineBreakMode="WordWrap" />

            <Label Text="Log" FontAttributes="Bold" />
            <Border Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                    StrokeThickness="1"
                    Padding="12"
                    StrokeShape="RoundRectangle 8">
                <Label x:Name="LogLabel"
                       Text="Logging is enabled."
                       FontSize="12"
                       LineBreakMode="WordWrap" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
